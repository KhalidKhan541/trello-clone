generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  avatar        String?
  createdAt     DateTime  @default(now())
  boards        Board[]
}

model Board {
  id            String    @id @default(cuid())
  title         String
  userId        String
  createdAt     DateTime  @default(now())
  lists         List[]
}

model List {
  id            String    @id @default(cuid())
  title         String
  boardId       String
  position      Int
  createdAt     DateTime  @default(now())
  cards         Card[]
}

model Card {
  id            String    @id @default(cuid())
  title         String
  description   String?
  listId        String
  position      Int
  labels        String[]
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
}
